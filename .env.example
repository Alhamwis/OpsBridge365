# OpsBridge365 - copy to .env and fill in. .env is gitignored; never commit it.
# In Azure these come from Container Apps secrets backed by Key Vault, not a file.

# All three AZURE_* values below belong to the MICROSOFT 365 tenant that holds
# the Graph app registration and the SharePoint site - not the Azure tenant that
# owns the subscription. They are different directories. The names keep the
# AZURE_ prefix only because that is the convention for a client-credentials app.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

SHAREPOINT_SITE_ID=
ASSETS_LIST_ID=
TICKETS_LIST_ID=

# Bearer token required by GET /metrics. Minimum 32 characters.
#
# Leaving this unset does NOT make /metrics public - the endpoint refuses with
# 503 rather than serving live tenant data. That is deliberate: a
# misconfiguration must not silently reopen an unauthenticated hole.
#
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# In Azure this comes from the Key Vault secret `metrics-api-token`, written
# once by infra/bootstrap.bicep. It is NOT a GitHub secret.
METRICS_API_TOKEN=

# Optional - sensible defaults are used when these are unset.
GRAPH_SCOPE=
APP_VERSION=
