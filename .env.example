# OpsBridge365 - copy to .env and fill in. .env is gitignored; never commit it.
# In Azure these come from Container Apps secrets backed by Key Vault, not a file.

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

SHAREPOINT_SITE_ID=
ASSETS_LIST_ID=
TICKETS_LIST_ID=

# Optional - sensible defaults are used when these are unset.
GRAPH_SCOPE=
APP_VERSION=
